#!/usr/bin/env bash
# Claude Code prompt editor: opens the prompt temp file in Emacs with the
# session transcript shown read-only above a separator. Only the text you
# type below the separator is saved back as the prompt.
set -euo pipefail

promptfile="${1:?no prompt file given}"
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR)"

# Only Claude's Ctrl-G prompt files get the transcript-above-prompt treatment.
# Anything else (Claude "open file in editor" actions routed through
# claude-pager) opens as a plain Emacs buffer, without waiting.
case "$(basename "$promptfile")" in
  claude-prompt-*) ;;
  *) exec emacsclient -n "$promptfile" ;;
esac
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EL="$SCRIPT_DIR/claude-prompt.el"

# --- resolve transcript .jsonl ---
# The editor is spawned with only CLAUDE_CODE_BRIDGE_SESSION_ID (no session UUID,
# no transcript path). Claude Code's own session registry maps that bridge id to
# the session UUID, which names the transcript file. Resolve through it — no
# cwd/newest-jsonl guessing; when the session can't be pinned, show nothing
# rather than another session's conversation.
transcript=""
uuid="${CLAUDE_CODE_SESSION_ID:-}"
if [[ -z "$uuid" && -n "${CLAUDE_CODE_BRIDGE_SESSION_ID:-}" ]]; then
  uuid=$(jq -r --arg b "$CLAUDE_CODE_BRIDGE_SESSION_ID" \
    'select(.bridgeSessionId==$b) | .sessionId' "$HOME/.claude/sessions"/*.json 2>/dev/null | head -1)
fi
# Bridge id goes stale after a relogin (registry entry ends up with
# bridgeSessionId=null). The registry is also keyed by the Claude process pid,
# and this script is a descendant of it — walk ancestor pids and match those.
if [[ -z "$uuid" ]]; then
  pid=$PPID depth=0
  while [[ "$pid" -gt 1 && "$depth" -lt 12 ]]; do
    reg="$HOME/.claude/sessions/$pid.json"
    if [[ -r "$reg" ]]; then
      # Reject a stale entry whose pid the OS has reused: the registry's
      # startedAt (epoch ms, trails process start by CLI boot time) must sit
      # just after the live process's start time.
      started=$(jq -r '(.startedAt // 0) / 1000 | floor' "$reg" 2>/dev/null)
      lstart=$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//;s/ *$//')
      pstart=$(date -j -f "%a %b %e %T %Y" "$lstart" +%s 2>/dev/null || echo 0)
      delta=$((started - pstart))
      if [[ "$started" -eq 0 || "$pstart" -eq 0 || ( "$delta" -ge -2 && "$delta" -le 60 ) ]]; then
        uuid=$(jq -r '.sessionId // ""' "$reg" 2>/dev/null)
        [[ -n "$uuid" ]] && break
      fi
    fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || break
    depth=$((depth + 1))
  done
fi
if [[ -n "$uuid" ]]; then
  transcript=$(ls "$HOME/.claude/projects"/*/"${uuid}.jsonl" 2>/dev/null | head -1 || true)
fi
[[ -n "$transcript" && ! -r "$transcript" ]] && transcript=""

# --- load lib + arm the pending transcript (non-blocking) ---
# If claude-pager pre-rendered the transcript to plain text, prefer that
# (single source of truth with the pager); else fall back to the .jsonl which
# Emacs renders itself.
tx_el="nil"
[[ -n "$transcript" && -r "$transcript" ]] && tx_el="\"$transcript\""
render_el="nil"
rf="${CLAUDE_PAGER_RENDER_FILE:-}"
[[ -n "$rf" && -r "$rf" ]] && render_el="\"$rf\""
emacsclient -e "(progn (load \"$EL\" nil t) (setq claude-prompt--pending t claude-prompt--pending-transcript $tx_el claude-prompt--pending-render $render_el))" \
  >/dev/null 2>&1 || true

# --- open the prompt file; blocks until C-x # ---
# Silence emacsclient's "Waiting for Emacs..." chatter: any byte written to
# the terminal here lands on top of Claude Code's UI and desyncs its
# differential repaint (the screen scrambles after the editor returns).
exec emacsclient "$promptfile" >/dev/null 2>&1
